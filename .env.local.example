# Subscription Doctor 環境変数
# このファイルを .env.local にコピーして使用してください

# === v1.1 で使用（MVP では不要） ===

# Gemini AI Fallback
GEMINI_MODEL_ID=gemini-2.5-flash-lite
GEMINI_API_KEY=

# Sentry エラー監視 (https://sentry.io で無料アカウント作成)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Supabase (v1.1)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
