# Subscription Doctor 環境変数
# このファイルを .env.local にコピーして使用してください
# すべてオプション — MVP は .env.local なしで完全動作します

# === Sentry エラー監視 ===
# https://sentry.io で無料アカウント作成後に設定
# NEXT_PUBLIC_SENTRY_DSN: クライアント側エラー収集
# SENTRY_DSN: サーバー側エラー収集
# SENTRY_ORG / SENTRY_PROJECT / SENTRY_AUTH_TOKEN: ソースマップアップロード（CI のみ）
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# === v1.1 で使用（現在は未実装） ===

# Gemini AI Fallback: 規則に一致しなかった取引の自動識別
# Gemini 2.5 Flash-Lite の無料枠: 15 RPM, 1000 RPD
GEMINI_MODEL_ID=gemini-2.5-flash-lite
GEMINI_API_KEY=

# Supabase: 将来の規則データベース移行用
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
